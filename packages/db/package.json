{
  "name": "@san7/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "create-admin": "tsx --env-file-if-exists=../../.env prisma/create-admin.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc -p .",
    "lint": "tsc -p . --noEmit",
    "build": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@san7/core": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "2.2.2",
    "@types/node": "22.20.5",
    "dotenv": "18.0.9",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
